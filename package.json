{
  "name": "ainsathi",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint src",
    "test": "vitest run",
    "preview": "vite preview --host 127.0.0.1",
    "db:types": "supabase gen types typescript --local > src/lib/database.generated.ts",
    "test:e2e": "playwright test",
    "db:types:embedded": "node scripts/generate-types.ts",
    "firebase:build": "npm --prefix firebase-functions run build",
    "firebase:deploy": "npx firebase-tools deploy --project ainsathi --only firestore:rules,firestore:indexes,storage,functions:ainsathi",
    "pretest": "node firebase-functions/scripts/copy-schema.mjs"
  },
  "dependencies": {
    "@fontsource/noto-sans-bengali": "^5.3.0",
    "@hookform/resolvers": "^5.9.1",
    "firebase": "^13.0.0",
    "lucide-react": "^1.54.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.89.0",
    "react-router-dom": "^7.18.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.9",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.6"
  }
}
